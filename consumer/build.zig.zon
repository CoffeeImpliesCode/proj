// SPDX-License-Identifier: MIT
// See FORK-LICENSE.md in the parent directory for what that identifier covers.

.{
    // This is a different package from the library: it exists only to consume
    // `dep.module("proj")` from outside. The name is what a dependent would write
    // in its own dependency map.
    .name = .proj_consumer,
    // The consumer's own version. It carries none of upstream's version; the
    // library's version is the one in the parent manifest, read out of
    // `src/proj.h:176-178`.
    .version = "0.1.0",
    // The value Zig 0.16.0 printed for this package name and manifest. The
    // field was deliberately absent, for the reason `lib/init/build.zig.zon:14-25`
    // gives: it is an identifier the toolchain derives, and one written before a
    // run would be invented. `zig build run` in this directory reported it:
    //
    //     build.zig.zon:4:2: error: missing top-level 'fingerprint' field;
    //     suggested value: 0xc08ab5c3397a7a1f
    //
    // The value a driver reads out of that run belongs in the manifest it is
    // for, and the comment that used to say otherwise is superseded by it.
    .fingerprint = 0xc08ab5c3397a7a1f,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // A relative path, not a registry or archive URL. This package is the proof
        // that `dep.module("proj")` works from outside the package that defines it;
        // resolving that through the network would make the proof depend on a
        // published state of the world instead.
        .proj = .{ .path = ".." },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}