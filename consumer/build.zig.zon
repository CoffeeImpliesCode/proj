// See FORK-LICENSE.md in the parent directory for what that identifier covers.

.{
    // This is a different package from the library: it exists only to consume
    // `dep.module("proj")` from outside. The name is what a dependent would write
    // in its own dependency map.
    .name = .proj_consumer,
    // The consumer's own version. It carries none of upstream's version; the
    // library's version is the one in the parent manifest, read out of
    // `src/proj.h:176-178`.
    .version = "0.1.0",
    // Zig 0.16.0 printed this fingerprint; it was not rechecked with Zig 0.17.0.
    .fingerprint = 0xc08ab5c3397a7a1f,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // A relative path, not a registry or archive URL. This package is the proof
        // that `dep.module("proj")` works from outside the package that defines it;
        // resolving that through the network would make the proof depend on a
        // published state of the world instead.
        .proj = .{ .path = ".." },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}