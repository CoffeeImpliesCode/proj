// Fork-authored manifest; see `FORK-LICENSE.md`.
.{
    .name = .proj,
    .fingerprint = 0x520c3c90ca08256e,
    // Upstream PROJ release; the build checks this against its headers.
    .version = "9.9.0",
    .minimum_zig_version = "0.16.0",
    // SQLite is vendored; this package fetches no dependencies.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        // Cross-test harness settings.
        "cross-test.profile.sh",
        // Published facade, API exercise, and translated header.
        "zig",
        // Unmodified upstream PROJ source.
        "src",
        // Upstream public include directory.
        "include",
        // Datum data and SQL inputs used to generate `proj.db`.
        "data",
        // Upstream build templates for generated inputs.
        "cmake",
        // Upstream SQL-generation scripts; this build does not run them.
        "scripts",
        // Upstream tests, retained but not compiled here.
        "test",
        // Upstream examples, retained but not compiled here.
        "examples",
        // Upstream man pages; this package does not install them.
        "man",
        // Upstream documentation, license, and build templates.
        "README.upstream.md",
        "COPYING",
        "CMakeLists.txt",
        "proj.pc.in",
        // Fork provenance and package documentation.
        "UPSTREAM.md",
        "UPSTREAM.sha256",
        "NOTICE.md",
        "FORK-LICENSE.md",
        "README.md",
        "README.zig.md",
        "CHANGELOG.md",
        "FORK-NOTES.md",
        // Package test root and example program.
        "tests.zig",
        "smoke.zig",
        // Example consumer package.
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // Provenance checker.
        "tools",
        // Runtime loader core and generated dispatch.
        "runtime",
        // Nix package and development-shell inputs.
        "package.nix",
        "flake.nix",
        "flake.lock",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
        // Ignore rules for local build artifacts.
        ".gitignore",
        // The allowlist excludes generated artifacts and local environment files.
    },
}
