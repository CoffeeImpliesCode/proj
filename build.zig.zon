// grant for this file, and `COPYING` holds upstream's own MIT text, unmodified.
//
.{
    // The package id and the name a dependent writes in its dependency map,
    // and the one registered module: `dep.module("proj")`. All three are
    // `proj`, and `dep.artifact("proj")` is the same string, which is what makes
    // Zig emit `libproj.a` -- the name a C consumer's `-lproj` needs and the
    // name upstream's own `PROJ_OUTPUT_NAME` gives off Windows
    // (`src/lib_proj.cmake:551`).
    .name = .proj,
    .fingerprint = 0x520c3c90ca08256e,
    // Upstream's own release, read out of `src/proj.h:176-178`
    // (`PROJ_VERSION_MAJOR 9`, `PROJ_VERSION_MINOR 9`, `PROJ_VERSION_PATCH 0`)
    // and out of `CMakeLists.txt:169` (`proj_version(MAJOR 9 MINOR 9 PATCH 0)`).
    // This is the version of the C and C++ library this package builds, not a
    // version of the wrapper. `build.zig` compares it against the same three
    // components and refuses to configure when the two disagree, so this string,
    // the pkg-config `Version:` field and the upstream header cannot describe
    // three different releases. It is deliberately *not* the shared object's
    // ABI version: `CMakeLists.txt:170-171` makes that `25.9.0`, and
    // `build.zig` carries it as `.version` on the artifact instead, because it
    // is a property of the delivery and not of the source.
    .version = "9.9.0",
    // `.fingerprint` is deliberately absent.
    //
    // `lib/init/build.zig.zon:16-25` says the field is generated by the Zig
    // toolchain when a package is first created and never changes; the driver
    // records the observed value in `FORK-NOTES.md`. Writing a value here would
    // be a fabricated identifier: it was not read out of any file or printed by
    // any command, and it is a trust identifier rather than a content one.
    .minimum_zig_version = "0.16.0",
    // Nothing is fetched: the C and C++ library is this repository's own
    // source, the one external dependency is the vendored
    // `vendor/sqlite3/sqlite3.c`, and the facade, tests, example, consumer and
    // runtime table import only what is compiled here. No system-library mode is
    // offered, so there is no `sqlite3` package to depend on either -- the
    // amalgamation is compiled into the archive.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        // The cross-test harness profile for this package. It is a file in the
        // package because it is how this package declares what its
        // cross-platform gate is: `cross-test` discovers it by name from the
        // package root, and it is settings only -- the standard `zig build test`
        // step over the full published 53-platform matrix, no target subset and
        // no host path. Nothing in build.zig reads it.
        "cross-test.profile.sh",
        // The Zig package's own roots. `zig/root.zig` is the published facade,
        // `zig/api_exercise.zig` the explicit exercise of every public facade
        // method that `check` compiles, and `zig/translate.h` the one translated
        // header. All three travel because a dependent reaches the facade
        // through `dep.module("proj")` and because this package's own `test`,
        // `check` and `consumer` steps compile the other two.
        "zig",
        // Upstream's PROJ 9.9.0, unmodified: the whole `proj` target's source
        // closure as `src/lib_proj.cmake` and `src/apps/lib_projapps.cmake`
        // enumerate it, plus every internal and public header those units reach
        // by bare name. The directory travels whole rather than as a hand-picked
        // list, because a build that needed a file outside the compiled closure
        // would have to edit upstream to get it, and because the uncompiled
        // material -- the command-line applications, `embedded_resources.c`,
        // `memvfs.c`, the bison grammars, the GTest tree under `src/tests/` --
        // is part of upstream's tree and its absence would make this a partial
        // import. Nothing here is edited, re-entered or regenerated.
        "src",
        // Upstream's own public header directory (`CMakeLists.txt` /
        // `src/lib_proj.cmake:306`), separate from `src/` upstream and separate
        // here, because the two are separate include directories and a header
        // absent from one of them must stay absent.
        "include",
        // The datum data and the recipe that builds the database from it. The
        // 50 SQL files under `data/sql/` are the inputs of the `proj.db`
        // generator, `data/sql/proj.db.sql.expected.md5` is the digest that
        // generator asserts against, and `data/generate_proj_db.cmake` plus
        // `data/sql_filelist.cmake` are upstream's own record of the order and
        // of the rule `build.zig` reproduces. The nine `+init` definition files,
        // `proj.ini`, `nad.lst`, `other.extra` and the three `*.schema.json`
        // files are what the install publishes to `share/proj/`. `data/tests/`
        // travels because it is upstream's material and is retained, not
        // installed.
        "data",
        // Upstream's own build wiring, kept as the record of what the generated
        // inputs mean: `cmake/proj_config.cmake.in` is the template
        // `proj_config.h` reproduces, `cmake/ProjConfig.cmake` decides its
        // macros, `cmake/ProjUtilities.cmake` is what substitutes `proj.pc.in`,
        // and `CMakeLists.txt` names the version, the SOVERSION and the
        // dictionary. Nothing in this package executes any of it.
        "cmake",
        // Upstream's Python helpers that generated `data/sql/`. They are not
        // run and not runnable here -- there is no EPSG dataset in this package
        // and no network -- and they are the record of how the SQL in `data/`
        // came to be what it is.
        "scripts",
        // Upstream's test tree, unmodified. Nothing in this package compiles it
        // (it is GTest-based and not part of the `proj` target), and
        // `test/unit/CMakeLists.txt:94-97` is the upstream record of which
        // directories its own build put on the include path. It travels because
        // it is upstream's material.
        "test",
        // Upstream's example programs and their CMake lists. Not compiled by
        // this package; retained, not reimplemented and not dropped.
        "examples",
        // Upstream's man pages and the CMake list that installs them. This
        // package installs no man page -- the installed layout in `build.zig`
        // has no `share/man` -- so these travel as upstream material rather
        // than as a delivery.
        "man",
        // Upstream's own build root and licence. `CMakeLists.txt` is what names
        // the version, `SOVERSION` and `PROJ_DICTIONARY`; `proj.pc.in` is the
        // template `lib/pkgconfig/proj.pc` is derived from;
        // `README.upstream.md` is upstream's own front page, preserved byte for
        // byte (upstream had no file by that name, so nothing of upstream's was
        // lost); and `COPYING` is the MIT-style text that covers every byte of
        // `src/`, `data/` and `include/`. The other five upstream top-level
        // files -- `AUTHORS.md`, `CITATION`, `CITATION.cff`, `ChangeLog`,
        // `INSTALL` and `NEWS.md` -- are upstream material that no route in this
        // package needs and that is not installed, so they stay in the
        // repository and out of the fetched package. Their digests are in
        // `UPSTREAM.sha256`, which does travel.
        "README.upstream.md",
        "COPYING",
        "CMakeLists.txt",
        "proj.pc.in",
        // This fork's records. They travel so that a fetched package can state
        // where its bytes came from: `UPSTREAM.sha256` is the digest list
        // `tools/check-provenance.sh` checks, `UPSTREAM.md` is the provenance
        // record, `NOTICE.md` is the per-file licence inventory, and
        // `FORK-LICENSE.md`, `README.md`, `README.zig.md`, `CHANGELOG.md` and
        // `FORK-NOTES.md` are this fork's own licence grant, documentation,
        // change log and driver receipts.
        "UPSTREAM.md",
        "UPSTREAM.sha256",
        "NOTICE.md",
        "FORK-LICENSE.md",
        "README.md",
        "README.zig.md",
        "CHANGELOG.md",
        "FORK-NOTES.md",
        // The test root and the example program, which `zig build test` and
        // `zig build smoke` compile and run and which `zig build check`
        // compiles for every matrix target. They are named individually rather
        // than as a directory because there is no directory to name.
        "tests.zig",
        "smoke.zig",
        // The separate consumer package: proof that the published module
        // resolves from a package that did not write it, through a relative
        // path rather than a fetch. The three files are named individually
        // because `build.zig`'s `consumer` step compiles
        // `consumer/src/main.zig` and because `consumer/.gitignore` is a
        // developer-tool artefact that no route needs.
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // The provenance script that checks the recorded digests and the exact
        // upstream file set, and the `provenance` step that runs it.
        "tools",
        // The runtime loader core the API role owns, and this library's
        // generated dispatch beside it. It is a dependency of the published
        // module under `-Druntime`, so a dependent that fetches this package
        // must receive it; `runtime/graph.zig` is the one place
        // `createModule` substitutes for `translate.createModule()`. The
        // directory is empty in a build that does not use `-Druntime`, and it
        // still travels.
        "runtime",
        // This fork's own CI. It is entirely the fork's -- upstream's tag
        // `9.9.0` tree ships no `.github` directory at all, so there is no
        // upstream workflow here that could be retargeted -- and it names only
        // steps `build.zig` defines.
        ".github",
        // Standalone Nix packaging. `package.nix` is the one source-only
        // derivation and builds the `.static` and `.dynamic` variants of this
        // same tree; `flake.nix` exposes them; `devenv.nix`, `devenv.yaml` and
        // `.envrc` provide the canonical development shell; `flake.lock` pins
        // the nixpkgs revision `flake.nix` names. `devenv.lock` is deliberately
        // absent: the driver owns it, and naming a path that is not there would
        // make `zig fetch` hash a missing entry.
        "package.nix",
        "flake.nix",
        "flake.lock",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
        // The ignore file, so a fetched package's own `.zig-cache/` and
        // `zig-out/` are ignored from the first build. It is named here and not
        // relied upon: the list below is an allowlist, so nothing not named can
        // reach the package regardless of what the ignore file says.
        ".gitignore",
        // `.zig-cache/`, `zig-out/`, `zig-pkg/`, `consumer/.zig-cache/`,
        // `consumer/zig-out/`, `consumer/zig-pkg/`, `result`, `result-*`,
        // `.devenv/`, `.devenv.flake.nix`, `.devenv.flakes/`,
        // `devenv.local.nix`, `.direnv/` and `devenv.lock` are all absent by
        // construction rather than by an ignore rule: this is an allowlist, so a
        // path that is not named here cannot be part of the package no matter
        // what exists in the working tree when it is hashed. See `.gitignore`
        // for what keeps them out of *commits*.
    },
}